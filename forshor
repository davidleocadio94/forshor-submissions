#!/usr/bin/env python3
"""ForShor contributor CLI. Requires Python 3.12+, Git, and GitHub CLI."""
from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
import uuid

REPO = 'zapatacomputing/forshor-submissions'
DASHBOARD = 'https://forshor-services.web.app'
POLICY = 'TableGeneration/Submission/Policy.lean'
SUMMARY = 'TableGeneration/Submission/summary.tex'
HELPERS = 'TableGeneration/Submission/Policy/'
POLICY_NAMESPACE = re.compile(r'^\s*namespace\s+(PTPPolicySubmission|PolicySubmission)\b', re.M)
TREES = 'evaluation/policy-trees.json'
VERIFIER = '.github/workflows/table-generation-submission.yml'
PUBLISHER = '.github/workflows/publish-results.yml'
PUBLICATION_V2 = 'forshor.publication/v2'
ELAN_REF = '55dc2814ca42ace25f05ba4dd7a43a8c701a0549'


class UserError(Exception):
    pass


def run(args, cwd=None, env=None, capture=True, check=True):
    result = subprocess.run([str(a) for a in args], cwd=cwd, env=env,
                            text=True, stdout=subprocess.PIPE if capture else None,
                            stderr=subprocess.PIPE if capture else None)
    if check and result.returncode:
        # Never display subprocess environment or authentication output.
        detail = (result.stderr or result.stdout or '').strip()[-1500:]
        raise UserError(f'{args[0]} {args[1] if len(args) > 1 else ""} failed. {detail}')
    return result


def git(root, *args):
    return run(['git', *args], cwd=root).stdout.strip()


def network_git(root, *args):
    # Per-command helper: no token storage and no global Git configuration changes.
    return git(root, '-c', 'credential.helper=', '-c',
               'credential.helper=!gh auth git-credential', *args)


def gh_json(*args):
    return json.loads(run(['gh', *args]).stdout)


def api(path):
    return gh_json('api', '--method', 'GET', f'repos/{REPO}/{path}')


def authenticate():
    if not shutil.which('gh'):
        raise UserError('Install GitHub CLI: https://cli.github.com/ then run this command again.')
    if run(['gh', 'auth', 'status', '--hostname', 'github.com'], check=False).returncode:
        if not sys.stdin.isatty():
            raise UserError('Sign into GitHub first: gh auth login --hostname github.com')
        run(['gh', 'auth', 'login', '--hostname', 'github.com', '--web',
             '--git-protocol', 'https'], capture=False)


def repository():
    result = run(['git', 'rev-parse', '--show-toplevel'], check=False)
    if result.returncode:
        raise UserError('Run this inside your forshor-submissions checkout, or use ./forshor setup DIRECTORY.')
    root = Path(result.stdout.strip()).resolve()
    origin = git(root, 'remote', 'get-url', 'origin').rstrip('/').removesuffix('.git')
    match = re.fullmatch(r'(?:https://github.com/|git@github.com:|ssh://git@github.com/)([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)', origin)
    if not match:
        raise UserError(f'Origin must be {REPO} or a GitHub fork of it. No files were submitted.')
    name = match[1]
    if name != REPO and not is_submission_fork(github_repository(name)):
        raise UserError(f'Origin is not a fork of {REPO}. No files were submitted.')
    return root


def github_repository(name, missing_ok=False):
    response = run(['gh', 'api', '--method', 'GET', f'repos/{name}'], check=False)
    try:
        data = json.loads(response.stdout)
    except ValueError:
        data = {}
    if response.returncode:
        if missing_ok and data.get('status') in (404, '404'):
            return None
        raise UserError(f'Could not inspect GitHub repository {name}. Check GitHub sign-in and repository access.')
    return data


def is_submission_fork(details):
    return bool(details.get('fork') and (
        (details.get('source') or {}).get('full_name') == REPO
        or (details.get('parent') or {}).get('full_name') == REPO))


def submission_repository(root):
    """Public submissions always use the authenticated user's fork.

    Authorized private staging contributors retain the existing upstream flow
    while company policy disables private forks. Never grant upstream access.
    """
    upstream = github_repository(REPO)
    if upstream.get('private') and upstream.get('permissions', {}).get('push'):
        return REPO
    login = gh_json('api', 'user')['login']
    name = f'{login}/{REPO.split("/")[1]}'
    details = github_repository(name, missing_ok=True)
    if details is None:
        run(['gh', 'repo', 'fork', REPO, '--clone=false', '--remote=false'])
        details = github_repository(name)
    if details.get('full_name', '').lower() != name.lower() or not is_submission_fork(details):
        raise UserError(f'{name} is not your fork of {REPO}. No files were pushed. Use a correctly linked fork.')
    return details['full_name']


def pull_requests(branch, head_repository):
    # REST's owner-qualified head filter avoids confusing identically named
    # branches in different forks. `gh pr list --head owner:branch` is unsupported.
    from urllib.parse import urlencode
    query = urlencode({'head': f'{head_repository.split("/")[0]}:{branch}',
                       'base': 'main', 'state': 'all', 'per_page': 100})
    pages = gh_json('api', '--method', 'GET', f'repos/{REPO}/pulls?{query}', '--paginate', '--slurp')
    return [{'number': pr['number'], 'url': pr['html_url'], 'headRefOid': pr['head']['sha'],
             'state': pr['state'].upper()} for page in pages for pr in page
            if (pr.get('head', {}).get('repo') or {}).get('full_name', '').lower() == head_repository.lower()]


def submission_branch():
    identifier = uuid.uuid4().hex
    # Four fixed GitHub concurrency groups, with one active verification each.
    # Routing is only scheduling; it grants no acceptance or publishing rights.
    lane = int(identifier[-1], 16) % 4
    return f'submission/q{lane}/' + time.strftime('%Y%m%d-%H%M%S') + '-' + identifier[:8]


def storage(root):
    path = Path(git(root, 'rev-parse', '--absolute-git-dir')) / 'forshor'
    path.mkdir(exist_ok=True, mode=0o700)
    return path


def read_state(root):
    path = storage(root) / 'state.json'
    return json.loads(path.read_text()) if path.exists() else {}


@contextmanager
def repository_lock(root):
    with (storage(root) / 'command.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise UserError('Another ForShor command is using this checkout. Finish or stop it first.') from None
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def write_state(root, state):
    path = storage(root) / 'state.json'
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(state, indent=2) + '\n')
    temporary.chmod(0o600)
    temporary.replace(path)


def allowed(path):
    return path == POLICY or (path.startswith(HELPERS) and path.endswith('.lean'))


def summary_rules():
    """The rules of the optional summary file, from the one definition the hosted verifier uses (`evaluation/summary_tex.py`, next to this script)."""
    import importlib.util
    path = Path(__file__).resolve().parent / 'evaluation' / 'summary_tex.py'
    if not path.is_file():
        raise UserError('This checkout predates summary.tex support. Fetch the latest main before adding a summary.')
    spec = importlib.util.spec_from_file_location('forshor_summary_tex', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def check_summary(root, paths):
    """The optional `summary.tex`: absent is fine; present it must be a regular UTF-8 text file within the limits (checked here exactly as the hosted check will, never compiled).
    It goes with a policy only. Returns True when there is a summary to submit."""
    path = Path(root) / SUMMARY
    if os.path.lexists(path):
        _, why = summary_rules().inspect_file(path)
        if why:
            raise UserError(why)
    elif SUMMARY in paths:
        raise UserError('summary.tex was deleted or renamed; a submission may only add it or edit it.')
    else:
        return False
    if not policy_format(root) or (paths and POLICY not in paths):
        raise UserError(f'A summary goes with a policy: {SUMMARY} cannot be submitted alone. Write your policy in {POLICY} first.')
    return True


def policy_format(root):
    """True when the submission file is a ForShor policy (`namespace PolicySubmission` or `PTPPolicySubmission`): the policy format, in which that file (and the optional summary.tex beside it) is the whole submission."""
    path = Path(root) / POLICY
    return path.is_file() and not path.is_symlink() and bool(POLICY_NAMESPACE.search(path.read_text(errors='replace')))


def validate_changes(root, base):
    # Check committed and staged/unstaged/untracked changes, including deletions.
    committed = git(root, 'diff', '--no-renames', '--name-only', '-z', f'{base}...HEAD').split('\0')
    raw = run(['git', 'status', '--porcelain=v1', '-z', '--untracked-files=all', '--no-renames'], cwd=root).stdout
    working = [entry[3:] for entry in raw.split('\0') if entry]
    paths = set(filter(None, committed + working))
    if SUMMARY in paths or os.path.lexists(root / SUMMARY):
        check_summary(root, paths)
    if policy_format(root):
        bad = sorted(path for path in paths if path not in (POLICY, SUMMARY))
        if bad:
            raise UserError(f'Only {POLICY} and the optional {SUMMARY} may change in a policy submission. Restore or move: ' + ', '.join(bad))
    else:
        bad = sorted(path for path in paths if not allowed(path))
        if bad:
            raise UserError('Only the submission file and its Lean helpers may change. Restore or move: ' + ', '.join(bad))
    for path in paths:
        if (root / path).is_symlink():
            raise UserError(f'Submission symlinks are not supported: {path}')
    if not (root / POLICY).is_file():
        raise UserError(f'The required file is missing: {POLICY}')
    return sorted(paths)


def source_files(root):
    if policy_format(root):
        summary = root / SUMMARY
        return [root / POLICY] + ([summary] if summary.is_file() and not summary.is_symlink() else [])
    files = [root / POLICY]
    helper = root / HELPERS
    if helper.exists():
        if helper.is_symlink():
            raise UserError('The submission helper directory must not be a symlink.')
        for path in helper.rglob('*'):
            if path.is_symlink():
                raise UserError('Submission helpers must not be symlinks.')
            if path.is_file() and path.suffix == '.lean':
                files.append(path)
    return sorted(files)


def fingerprint(root, base):
    digest = hashlib.sha256(base.encode())
    for path in source_files(root):
        digest.update(str(path.relative_to(root)).encode() + b'\0' + path.read_bytes() + b'\0')
    return digest.hexdigest()


def refresh_base(root):
    # Origin may be a participant's fork. The verifier always comes from the
    # fixed company repository, never that fork's main or a user-set upstream.
    reference = 'refs/remotes/forshor-upstream/main'
    network_git(root, 'fetch', '--no-tags', f'https://github.com/{REPO}.git',
                f'+refs/heads/main:{reference}')
    return git(root, 'rev-parse', reference)


def logged(root, label, args, cwd, env=None):
    print(label, flush=True)
    directory = root / 'artifacts' / 'forshor'
    directory.mkdir(parents=True, exist_ok=True)
    logfile = directory / (re.sub(r'[^a-z0-9]+', '-', label.lower()).strip('-') + '.log')
    with logfile.open('w') as output:
        result = subprocess.run([str(a) for a in args], cwd=cwd, env=env,
                                text=True, stdout=output, stderr=subprocess.STDOUT)
    if result.returncode:
        raise UserError(f'{label} failed. Details: {logfile}')


def supported_toolchain(text):
    """A pinned Lean release, or a pinned release candidate (`v4.36.0-rc1`: the repository's toolchain moved to one)."""
    return bool(re.fullmatch(r'leanprover/lean4:v[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?', text))


def lean_environment(root, base):
    env = dict(os.environ)
    env['PATH'] = str(Path.home() / '.elan/bin') + os.pathsep + env.get('PATH', '')
    toolchain = git(root, 'show', f'{base}:lean-toolchain').strip()
    if not supported_toolchain(toolchain):
        raise UserError('The trusted Lean toolchain is not a supported pinned release.')
    if not shutil.which('elan', path=env['PATH']):
        print('Installing the Lean toolchain manager…', flush=True)
        with tempfile.TemporaryDirectory(prefix='forshor-elan-') as directory:
            installer = Path(directory) / 'elan-init.sh'
            url = f'https://raw.githubusercontent.com/leanprover/elan/{ELAN_REF}/elan-init.sh'
            with urllib.request.urlopen(url, timeout=60) as response:
                installer.write_bytes(response.read())
            logged(root, 'Install Lean manager', ['sh', installer, '-y', '--no-modify-path',
                                                '--default-toolchain', 'none'], root, env)
    installed = run(['elan', 'toolchain', 'list'], cwd=root, env=env).stdout
    if toolchain not in [line.split()[0] for line in installed.splitlines() if line.strip()]:
        logged(root, 'Install pinned Lean', ['elan', 'toolchain', 'install', toolchain], root, env)
    env['ELAN_TOOLCHAIN'] = toolchain
    logged(root, 'Prepare pinned Lean', ['elan', 'run', toolchain, 'lean', '--version'], root, env)
    return env


def trusted_checkout(root, base):
    cache = storage(root) / 'checker'
    marker = storage(root) / 'checker-owned'
    if cache.exists() and not marker.exists():
        raise UserError(f'Refusing to replace an unrecognized checker directory: {cache}')
    if not cache.exists():
        run(['git', 'clone', '--shared', '--no-checkout', str(root), str(cache)])
        marker.write_text('ForShor generated checker checkout\n')
    git(cache, 'fetch', '--no-tags', 'origin', base)
    git(cache, 'checkout', '--detach', '--force', base)
    git(cache, 'reset', '--hard', base)
    # Remove only leftover generated submission helpers, never a user's checkout.
    helpers = cache / HELPERS
    if helpers.exists():
        shutil.rmtree(helpers)
    return cache


def prepare(root, base, env):
    cache = trusted_checkout(root, base)
    ready = storage(root) / 'prepared.json'
    if ready.exists() and json.loads(ready.read_text()).get('base') == base:
        return cache
    print('Preparing dependencies. The first setup can take several minutes.', flush=True)
    logged(root, 'Fetch prebuilt dependencies', ['lake', 'exe', 'cache', 'get'], cache, env)
    logged(root, 'Build trusted checker', ['lake', 'build', 'TableGeneration.Submission.Correctness',
           'TableGeneration.Metrics'], cache, env)
    ready.write_text(json.dumps({'base': base}))
    return cache


def prepare_policy(root, base, cache, env):
    """The trusted environment of a policy submission: the STO fork's tree (the mirror's), ForShor's tree (the gate and the build) and the engine's Python, each built once
    under .git/forshor and named in `evaluation/policy-trees.json` of the base commit. Returns what `scripts/policy_verifier.py` reads as environment."""
    config = json.loads((cache / TREES).read_text())
    forshor = storage(root) / ('forshor-' + config['forshor']['ref'][:12])
    sto = cache if config['sto'].get('repo') == 'self' else storage(root) / ('sto-' + config['sto']['ref'][:12])
    venv = storage(root) / 'engine-venv'
    ready = storage(root) / 'prepared-policy.json'
    wanted = {'forshor': config['forshor'], 'sto': config['sto'], 'base': base}
    if not (ready.exists() and json.loads(ready.read_text()) == wanted):
        print('Preparing the policy checkers (ForShor, the STO mirror, the engine). The first time takes a while.', flush=True)
        # ForShor and the STO fork each pin their own toolchain; do not force the repository's onto them.
        tree_env = {key: value for key, value in env.items() if key != 'ELAN_TOOLCHAIN'}
        for name, path, spec, build in (('ForShor', forshor, config['forshor'], config['forshor_build']), ('STO mirror', sto, config['sto'], config['sto_build'])):
            if spec.get('repo') != 'self':       # the STO mirror's tree is usually the trusted checkout itself (already at the base commit)
                if not path.exists():
                    network_git(root, 'clone', '--no-checkout', spec['repo'], str(path))
                git(path, 'checkout', '--detach', '--force', spec['ref'])
            logged(root, f'Fetch {name} dependencies', ['lake', 'exe', 'cache', 'get'], path, tree_env)
            logged(root, f'Build {name}', ['lake', 'build', *build], path, tree_env)
        if not venv.exists():
            # the engine's requirements are pinned for Python 3.12
            python = shutil.which('python3.12') or sys.executable
            run([python, '-m', 'venv', str(venv)])
        logged(root, 'Install the engine environment', [venv / 'bin' / 'pip', 'install', '-r', str(cache / config['engine_requirements'])], cache, env)
        ready.write_text(json.dumps(wanted))
    return {'FORSHOR_TREE': str(forshor), 'STO_TREE': str(sto), 'ENGINE_PYTHON': str(venv / 'bin' / 'python')}


def setup(args):
    authenticate()
    if args.directory:
        target = Path(args.directory).expanduser().resolve()
        if target.exists():
            raise UserError(f'The target already exists; choose a new directory: {target}')
        run(['gh', 'repo', 'clone', REPO, str(target)], capture=False)
        os.chdir(target)
    root = repository()
    with repository_lock(root):
        base = refresh_base(root)
        validate_changes(root, base)
        env = lean_environment(root, base)
        cache = prepare(root, base, env)
        if (cache / TREES).is_file():
            prepare_policy(root, base, cache, env)
    print(f'Ready. Edit {POLICY}, then run ./forshor check.')
    if args.directory:
        print(f'Checkout: {root}\nRun subsequent commands inside that directory.')


def check(root=None, base=None):
    authenticate()
    root = root or repository()
    base = base or refresh_base(root)
    validate_changes(root, base)
    digest = fingerprint(root, base)
    if policy_format(root):
        # Run only the fetched company checker's source filter, before setup
        # or compilation. A fork cannot provide its own acceptance script.
        trusted = trusted_checkout(root, base)
        run([sys.executable, trusted / 'scripts/ci/policy_source.py', root / POLICY], cwd=trusted)
    env = lean_environment(root, base)
    cache = prepare(root, base, env)
    for path in source_files(root):
        target = cache / path.relative_to(root)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(path.read_bytes())
    git(cache, 'add', '--', 'TableGeneration/Submission')
    run(['git', '-c', 'user.name=ForShor local checker', '-c', 'user.email=local-check@invalid',
         'commit', '--allow-empty', '-m', 'Local submission verification'], cwd=cache)
    env.update(TABLE_GEN_BASE_SHA=base, TABLE_GEN_HEAD_SHA=git(cache, 'rev-parse', 'HEAD'),
               TABLE_GEN_BASE_REPOSITORY=REPO)
    if policy_format(root):
        env.update(prepare_policy(root, base, cache, env), TABLE_GEN_LOGIN=gh_json('api', 'user')['login'])
    artifacts = root / 'artifacts' / 'forshor' / 'verification'
    # The script, config, adapters and model come from the fetched main commit.
    logged(root, 'Checking the submission in Lean', [sys.executable, 'scripts/verifier.py',
           '--out-dir', str(artifacts)], cache, env)
    result = json.loads((artifacts / 'table-generation-submission-result.json').read_text())
    if result.get('status') != 'success' or result.get('phase') != 'full':
        raise UserError(f'Full verification did not succeed. Read {artifacts}/table-generation-summary.md')
    if fingerprint(root, base) != digest:
        raise UserError('The submission changed during verification. Run ./forshor check again.')
    state = read_state(root)
    state['checked'] = {'base': base, 'digest': digest}
    write_state(root, state)
    print('Local verification passed. Run ./forshor submit when ready.')
    return base, digest


def validate_pr(pr, head, head_repository=REPO):
    if pr.get('head', {}).get('sha') != head:
        raise UserError('This PR now points to another commit. Run ./forshor status for the current submission.')
    if (pr.get('base', {}).get('ref') != 'main'
            or (pr.get('base', {}).get('repo') or {}).get('full_name') != REPO
            or (pr.get('head', {}).get('repo') or {}).get('full_name') != head_repository):
        raise UserError('The PR does not match the recorded source repository and company main branch.')


def publication_matches(source, submission, verification):
    source_run, pr = source.get('run', {}), source.get('pr', {})
    return (source_run.get('id') == verification['id']
            and source_run.get('run_attempt') == verification['run_attempt']
            and source_run.get('head_sha') == submission['head']
            and pr.get('number') == submission['pr']
            and pr.get('headSha') == submission['head'])


def repeated_policy(result):
    """What to tell the author when the publisher refused the policy as a repeat of one already published (None for anything else, including a malformed receipt)."""
    found = result.get('duplicateOf') if isinstance(result, dict) and result.get('refused') is True and result.get('stage') == 'duplicate' else None
    if not (isinstance(found, dict) and re.fullmatch(r'[a-f0-9]{40}', str(found.get('policyId', ''))) and type(found.get('pull')) is int and found['pull'] > 0
            and re.match(r'\d{4}-\d{2}-\d{2}', str(found.get('createdAt', '')))):
        return None
    earlier = f"pull request #{found['pull']} (commit {found['policyId'][:7]}, {found['createdAt'][:10]})"
    if found.get('sameParticipant') is True:
        return f'Not published: you already submitted this exact policy as {earlier}. Each policy can be published once per participant; nothing is wrong with the policy itself. Submit a different policy.'
    return f'Not published: this exact policy is already published as {earlier}. Nothing is wrong with the policy itself. Submit a different policy.'


def publication_result(run_record, source, result, submission, verification):
    if not publication_matches(source, submission, verification):
        return None
    repeat = repeated_policy(result)
    if repeat:
        raise UserError(repeat)
    if run_record.get('conclusion') != 'success':
        raise UserError(f'Publication failed. Details: {run_record["html_url"]}. A maintainer can rerun its failed publishing job without repeating Lean. Follow recovery with ./forshor status --watch.')
    if not result or (not result.get('alreadyPublished') and not re.fullmatch(r'[a-f0-9]{64}', str(result.get('snapshotId', '')))):
        raise UserError('The matching workflow finished without a publication receipt. Inspect its diagnostics.')
    outcome = {'stage': 'published', 'pr': submission['url'], 'commit': submission['head'],
               'verification': verification['html_url'], 'publication': run_record['html_url'],
               'snapshotId': result.get('snapshotId'), 'alreadyPublished': bool(result.get('alreadyPublished')),
               'submission': f'https://github.com/{REPO}/tree/submission-results/results/policies/{submission["head"]}',
               'dashboard': DASHBOARD}
    if result.get('schema') == PUBLICATION_V2:
        # A policy: the receipt names the row and the boards it is on; the page is the place to look at it.
        outcome.update({'kind': 'policy', 'name': result.get('name'), 'boards': result.get('boards') or [],
                        'submission': f'{DASHBOARD}/#results'})
    return outcome


def verification_feedback(verification, submission):
    """Read a failed attempt's JSON as data; never execute artifact contents."""
    try:
        with tempfile.TemporaryDirectory(prefix='forshor-verification-') as directory:
            downloaded = run(['gh', 'run', 'download', str(verification['id']), '--repo', REPO,
                              '--name', f'table-generation-submission-{verification["id"]}-{verification["run_attempt"]}',
                              '--dir', directory], check=False)
            path = Path(directory) / 'table-generation-submission-result.json'
            if downloaded.returncode or not path.is_file() or path.stat().st_size > 1_000_000:
                return None
            result = json.loads(path.read_text())
            if not isinstance(result, dict):
                return None
            metadata = result.get('metadata')
            expected = {'repository': REPO, 'head_sha': submission['head'], 'pr_number': str(submission['pr']),
                        'run_id': str(verification['id']), 'run_attempt': str(verification['run_attempt'])}
            if not isinstance(metadata, dict) or any(str(metadata.get(k, '')) != v for k, v in expected.items()):
                return None
            return result
    except (OSError, ValueError):
        return None  # Missing diagnostics must not conceal the failed verification.


def hosted_failure(verification, result=None):
    """Why a hosted verification did not pass. The conclusion alone cannot say whose fault it is, so do not blame the submission."""
    details_url = f'Details: {verification["html_url"]}'
    if verification['conclusion'] == 'timed_out':
        return f'Stopped: time limit reached. This is not a verdict on your policy. {details_url}'
    if verification['conclusion'] == 'action_required':
        return f'Waiting for a maintainer to approve the GitHub Actions run. {details_url}'
    if isinstance(result, dict) and result.get('status') == 'failure' and isinstance(result.get('checks'), list):
        failed = next((c for c in result['checks'] if isinstance(c, dict) and c.get('status') != 'success'), None)
        if failed and verification['conclusion'] == 'failure':
            name, detail = failed.get('name'), str(failed.get('details', ''))
            if name == 'memory' or re.search(r'killed: memory [\d.]+ G(?:i)?B > cap [\d.]+ G(?:i)?B', detail):
                return ('Stopped: memory limit reached. This is not a verdict on your policy.\n'
                        "We're working towards supporting submissions that need more memory. "
                        f'A maintainer can retry verification when more capacity is available. {details_url}')
            if name == 'timeout' or re.search(r'killed: timeout [\d.]+ s', detail):
                return f'Stopped: time limit reached. This is not a verdict on your policy. {details_url}'
            if name in {'forshor', 'check', 'threshold', 'widths', 'cert', 'replay', 'audit', 'mirror', 'axiom dependencies'}:
                return f'Proof check failed. Open the run summary for the failed check and its details. {details_url}'
    return (f'The hosted Lean verification did not pass ({verification["conclusion"]}). {details_url}\n'
            'Open the run summary: it names the check that failed. If that is the hosted environment (for example `trees`: the runner has no '
            'prepared Lean trees), the cause is the hosted setup and not your policy; `./forshor check` verifies the same file locally. '
            'If it names your policy, fix it and run ./forshor submit again.')


def inspect_status(submission, inspected):
    pr = api(f'pulls/{submission["pr"]}')
    validate_pr(pr, submission['head'], submission.get('repository', REPO))
    verifiers = api(f'actions/workflows/table-generation-submission.yml/runs?head_sha={submission["head"]}&event=pull_request&per_page=100')['workflow_runs']
    verifiers = [r for r in verifiers if r['path'] == VERIFIER and r['event'] == 'pull_request']
    if not verifiers:
        return {'stage': 'Queued — waiting for verification', 'pr': submission['url']}
    verification = max(verifiers, key=lambda r: (r['id'], r['run_attempt']))
    if verification['status'] != 'completed':
        jobs = api(f'actions/runs/{verification["id"]}/attempts/{verification["run_attempt"]}/jobs?per_page=100')['jobs']
        running = any(j['name'] == 'Verify submission with Lean' and j['status'] == 'in_progress' for j in jobs)
        return {'stage': 'Verifying — preparing and checking your submission' if running else 'Queued — waiting for verification',
                'verification': verification['html_url']}
    if verification['conclusion'] != 'success':
        result = verification_feedback(verification, submission) if verification['conclusion'] == 'failure' else None
        raise UserError(hosted_failure(verification, result))
    # Publisher workflow head SHA is main, never the submitted SHA. Match its
    # trusted diagnostics to the exact verifier ID/attempt, PR and source commit.
    from urllib.parse import urlencode
    query = urlencode({'event': 'workflow_run', 'created': '>=' + verification['created_at'], 'per_page': 100})
    pages = gh_json('api', '--method', 'GET', f'repos/{REPO}/actions/workflows/publish-results.yml/runs?{query}', '--paginate', '--slurp')
    publishers = [r for page in pages for r in page['workflow_runs']
                  if r['path'] == PUBLISHER and r['event'] == 'workflow_run' and r['status'] == 'completed']
    for candidate in sorted(publishers, key=lambda r: (r['id'], r['run_attempt']), reverse=True):
        key = (candidate['id'], candidate['run_attempt'], verification['id'], verification['run_attempt'])
        if key in inspected:
            continue
        name = f'publication-{candidate["id"]}-{candidate["run_attempt"]}'
        artifacts = api(f'actions/runs/{candidate["id"]}/artifacts?per_page=100')['artifacts']
        if not any(a['name'] == name and not a['expired'] for a in artifacts):
            continue  # Artifacts may become visible just after completion.
        with tempfile.TemporaryDirectory(prefix='forshor-receipt-') as directory:
            run(['gh', 'run', 'download', str(candidate['id']), '--repo', REPO,
                 '--name', name, '--dir', directory])
            source_path = Path(directory) / 'publication-source.json'
            if not source_path.exists():
                inspected.add(key)
                continue
            source = json.loads(source_path.read_text())
            result_path = Path(directory) / 'publication-result.json'
            result = json.loads(result_path.read_text()) if result_path.exists() else None
            outcome = publication_result(candidate, source, result, submission, verification)
            if outcome:
                return outcome
        inspected.add(key)
    return {'stage': 'Lean passed; waiting for resource estimation and publication',
            'verification': verification['html_url'], 'pr': submission['url']}


def watch(root, args):
    state = read_state(root)
    submission = state.get('submission')
    if not submission:
        raise UserError('No submission is recorded in this checkout. Run ./forshor submit first.')
    deadline, previous, inspected = time.monotonic() + args.timeout, None, set()
    while True:
        outcome = inspect_status(submission, inspected)
        if outcome['stage'] != previous:
            print(outcome['stage'].capitalize(), flush=True)
            previous = outcome['stage']
        if outcome['stage'] == 'published':
            if outcome.get('kind') == 'policy':
                boards = ', '.join(outcome.get('boards') or []) or 'the boards'
                print(f'Published as {outcome.get("name") or "your policy"} on {boards}.\nResults: {outcome["submission"]}\nRefresh the page to load the latest results. A new winner is not guaranteed.')
            else:
                print(f'Submission: {outcome["submission"]}\nDashboard: {outcome["dashboard"]}\nRefresh the dashboard to load the latest results. A new winner is not guaranteed.')
            state['published'] = outcome
            write_state(root, state)
        if outcome['stage'] == 'published' or not args.watch:
            if args.json:
                print(json.dumps(outcome))
            return outcome
        if time.monotonic() >= deadline:
            raise UserError('Still queued or running. No job was cancelled. Resume with ./forshor status --watch.')
        time.sleep(10)


def submit(args):
    authenticate()
    root = repository()
    base = refresh_base(root)
    paths = validate_changes(root, base)
    digest = fingerprint(root, base)
    state = read_state(root)
    if state.get('checked') != {'base': base, 'digest': digest}:
        check(root, base)
        state = read_state(root)
    if not paths:
        if state.get('submission'):
            return watch(root, args)
        raise UserError('No changes to submit. Edit Policy.lean first.')
    head_repository = submission_repository(root)
    branch = git(root, 'branch', '--show-current')
    prs = []
    new_branch = not branch or branch in ('main', 'submission-results')
    if not new_branch:
        # Discover before pushing: GitHub also updates the recorded head of a
        # closed PR, but pushing there does not trigger submission verification.
        prs = pull_requests(branch, head_repository)
        head = git(root, 'rev-parse', 'HEAD')
        dirty = bool(git(root, 'status', '--porcelain', '--untracked-files=all'))
        new_branch = bool(prs) and not any(p['state'] == 'OPEN' for p in prs) and (
            dirty or not any(p['headRefOid'] == head for p in prs))
    if new_branch:
        branch = submission_branch()
        git(root, 'switch', '-c', branch)
        prs = []
    git(root, 'add', '--', *paths)
    staged = run(['git', 'diff', '--cached', '--quiet'], cwd=root, check=False).returncode
    if staged:
        user = gh_json('api', 'user')
        options = []
        for key, default in [('user.name', user['login']), ('user.email', f'{user["id"]}+{user["login"]}@users.noreply.github.com')]:
            if run(['git', 'config', key], cwd=root, check=False).returncode:
                options.extend(['-c', f'{key}={default}'])
        git(root, *options, 'commit', '-m', args.title)
    if fingerprint(root, base) != digest:
        raise UserError('Submission files changed during commit. Check again before pushing.')
    head = git(root, 'rev-parse', 'HEAD')
    network_git(root, 'push', f'https://github.com/{head_repository}.git', f'HEAD:refs/heads/{branch}')
    matching = next((pr for pr in prs if pr['headRefOid'] == head), None)
    if matching:
        number, url = matching['number'], matching['url']
    elif any(pr['state'] == 'OPEN' for pr in prs):
        pr = next(pr for pr in prs if pr['state'] == 'OPEN')
        number, url = pr['number'], pr['url']
    else:
        body = 'Submit a policy through the ForShor CLI. Hosted verification, resource estimation and publication determine acceptance.'
        with tempfile.TemporaryDirectory(prefix='forshor-pr-') as directory:
            bodyfile = Path(directory) / 'body.md'
            bodyfile.write_text(body + '\n')
            qualified_head = branch if head_repository == REPO else f'{head_repository.split("/")[0]}:{branch}'
            url = run(['gh', 'pr', 'create', '--repo', REPO, '--base', 'main', '--head', qualified_head,
                       '--title', args.title, '--body-file', str(bodyfile)]).stdout.strip()
        number = int(url.rstrip('/').split('/')[-1])
    validate_pr(api(f'pulls/{number}'), head, head_repository)
    state['submission'] = {'pr': number, 'url': url, 'head': head, 'branch': branch, 'repository': head_repository}
    write_state(root, state)
    print(f'Submitted: {url}\nCommit: {head}', flush=True)
    return watch(root, args)


def main(argv=None):
    parser = argparse.ArgumentParser(description='Prepare, verify, and submit ForShor policies.')
    commands = parser.add_subparsers(dest='command', required=True)
    setup_parser = commands.add_parser('setup', help='Prepare pinned Lean and the trusted checker.')
    setup_parser.add_argument('directory', nargs='?', help='Clone a fresh checkout into this new directory first.')
    commands.add_parser('check', help='Fully verify the edited policy locally, without committing your working files.')
    for name in ('submit', 'status'):
        p = commands.add_parser(name, help='Submit a PR and follow publication.' if name == 'submit' else 'Show or follow the last submission.')
        p.add_argument('--timeout', type=int, default=3600, help='Seconds to wait (default 3600).')
        p.add_argument('--json', action='store_true', help='Also print a JSON status record.')
        if name == 'submit':
            p.add_argument('--title', default='Submit a ForShor policy')
            p.add_argument('--no-wait', dest='watch', action='store_false', default=True)
        else:
            p.add_argument('--watch', action='store_true')
    args = parser.parse_args(argv)
    try:
        if sys.version_info < (3, 12):
            raise UserError('Use Python 3.12 or newer to run ForShor.')
        if not shutil.which('git'):
            raise UserError('Install Git first: https://git-scm.com/downloads')
        if args.command == 'setup':
            setup(args)
        else:
            authenticate()
            root = repository()
            with repository_lock(root):
                if args.command == 'check':
                    check(root)
                elif args.command == 'submit':
                    submit(args)
                else:
                    authenticate()
                    watch(root, args)
        return 0
    except (UserError, OSError, ValueError, KeyError) as error:
        print(f'ForShor: {error}', file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print('\nStopped watching locally. Hosted jobs continue; resume with ./forshor status --watch.', file=sys.stderr)
        return 130


if __name__ == '__main__':
    sys.exit(main())
